# Backend API Base URL
# - In standard production where Express serves client/dist, leave empty (defaults to relative '/api')
# - If hosted on a separate static host (e.g. Vercel/Netlify), set your backend URL:
#   VITE_API_URL=https://api.goldenzone.in/api
VITE_API_URL=
